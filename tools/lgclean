#!/usr/bin/env bash
# lgclean: run tools/webos-clean.sh on a rooted LG webOS TV over SSH, from your computer.
#
#   tools/lgclean <tv-ip> [-n] <command> [list-file]
#
#   tools/lgclean 192.168.0.50 status
#   tools/lgclean 192.168.0.50 -n hide-apps examples/lg-65qned866qa-webos22/hide.txt   # dry run first
#   tools/lgclean 192.168.0.50 hide-apps examples/lg-65qned866qa-webos22/hide.txt
#   tools/lgclean 192.168.0.50 restore
#
# Needs SSH enabled in the Homebrew Channel (root). Set LGCLEAN_SSH="-i ~/.ssh/my_key" for extra ssh options.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
[ $# -ge 2 ] || { sed -n '3,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
tv=$1; shift
dry=(); [ "${1:-}" = "-n" ] && { dry=(-n); shift; }
cmd=$1; list=${2:-}
case "$cmd" in status|promos-off|promos-on|preload-off|preload-on|hide-apps|show-apps|apply|restore) ;;
    *) echo "unknown command: $cmd" >&2; exit 2 ;; esac
ssh_opts=(-o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 ${LGCLEAN_SSH:-})

ssh "${ssh_opts[@]}" "root@$tv" 'mkdir -p /tmp/webos-clean'
scp -q "${ssh_opts[@]}" "$here/webos-clean.sh" "root@$tv:/tmp/webos-clean/webos-clean.sh"
remote_list=""
if [ -n "$list" ]; then
    [ -r "$list" ] || { echo "cannot read $list" >&2; exit 1; }
    scp -q "${ssh_opts[@]}" "$list" "root@$tv:/tmp/webos-clean/list.txt"
    remote_list=/tmp/webos-clean/list.txt
fi
# -tt: luna-send wants a terminal
ssh -tt "${ssh_opts[@]}" "root@$tv" "sh /tmp/webos-clean/webos-clean.sh ${dry[*]:-} $cmd $remote_list; exit" | tr -d '\r'
